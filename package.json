{
  "name": "sharemyfile",
  "version": "1.0.0",
  "description": "High-speed local WiFi file and text sharing platform for Laptop, iPhone, and Android",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && node -e \"require('fs').cpSync('client/dist', 'dist', {recursive: true})\"",
    "dev": "node server/index.js"
  },
  "keywords": [
    "file-sharing",
    "wifi",
    "airdrop-alternative",
    "cross-platform",
    "local-network"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  }
}
